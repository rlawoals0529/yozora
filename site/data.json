  "pairings": [
    {
      "id": "ink-study",
      "title": "Ink Study - Fraunces + Chivo.",
      "why": "For something that teaches. Fraunces has a wonk axis and real optical sizing, so at display size it looks drawn rather than generated, and that is the whole reason to use it: a page explaining how something works should not look like it was assembled.",
      "load": "https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&display=swap",
      "display": "Fraunces",
      "body": "Chivo",
      "mono": "JetBrains Mono"
    },
    {
      "id": "neon-sign",
      "title": "Neon Sign - Syne + Manrope.",
      "why": "Syne is wide, high-contrast and slightly strange, which is exactly what a heading is for: it has to be recognisable at a glance and it is read once. Manrope carries the body without imitating it.",
      "load": "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Syne:wght@600;700;800&display=swap",
      "display": "Syne",
      "body": "Manrope",
      "mono": "JetBrains Mono"
    },
    {
      "id": "night-terminal",
      "title": "Night Terminal - Archivo + JetBrains Mono.",
      "why": "For a tool whose screen is mostly numbers. Archivo is a grotesque with even colour and unambiguous figures; JetBrains Mono carries every quantity, so columns line up and a changing value does not shift its neighbours sideways.",
      "load": "https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap",
      "display": "Archivo",
      "body": "Archivo",
      "mono": "JetBrains Mono"
    },
    {
      "id": "paper-lantern",
      "title": "Paper Lantern - Instrument Serif + Instrument Sans.",
      "why": "A serif headline over a sans body. This is the pairing to reach for first, because all-sans is the single loudest tell that nobody chose the type: a page where the heading and the paragraph are the same face at different sizes reads as a default. Two families give contrast that size alone cannot.",
      "load": "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap",
      "display": "Instrument Serif",
      "body": "Instrument Sans",
      "mono": "JetBrains Mono"
    }
  ]
}
